<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>57</ID>
      <Description>"Save Pos"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

local basePtr = getAddressSafe("croc2.exe+BC7CE8")
local structBase = basePtr and readPointer(basePtr)
if structBase then
    local addrPlayerPos   = structBase + 0x4C
    local addrPlayerAngle = structBase + 0x40
    savedPlayerPos   = readBytes(addrPlayerPos,   0xC, true)
    savedPlayerAngle = readBytes(addrPlayerAngle, 0x4, true)
end

[ENABLE]
[DISABLE]
</AssemblerScript>
      <Hotkeys>
        <Hotkey Active="0">
          <Action>Toggle Activation</Action>
          <Keys>
            <Key>22549</Key>
          </Keys>
          <ID>1</ID>
        </Hotkey>
        <Hotkey Active="0">
          <Action>Toggle Activation</Action>
          <Keys>
            <Key>81</Key>
          </Keys>
          <ID>0</ID>
        </Hotkey>
        <Hotkey>
          <Action>Toggle Activation</Action>
          <Keys>
            <Key>22550</Key>
          </Keys>
          <ID>2</ID>
        </Hotkey>
      </Hotkeys>
    </CheatEntry>
    <CheatEntry>
      <ID>58</ID>
      <Description>"Restore pos"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

if savedPlayerPos then
  local basePtr = getAddressSafe("croc2.exe+BC7CE8")
  local structBase = basePtr and readPointer(basePtr)
  if structBase then
     local addrPlayerPos   = structBase + 0x4C
     local addrPlayerAngle = structBase + 0x40
     writeBytes(addrPlayerPos,   savedPlayerPos)
     writeBytes(addrPlayerAngle, savedPlayerAngle)
  end
end

[ENABLE]
[DISABLE]

</AssemblerScript>
